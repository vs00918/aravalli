datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Chapter {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  icon        String     @default("📖")
  description String
  overview    String?
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  concepts    Concept[]
  questions   Question[]
}

model Concept {
  id                    String          @id @default(cuid())
  slug                  String          @unique
  title                 String
  chapterId             String
  chapter               Chapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  
  // Knowledge Architecture & Progression
  difficulty            String          @default("CORE") // "FOUNDATION" | "CORE" | "INTERMEDIATE" | "ADVANCED" | "FRONTIER"
  order                 Int             @default(0)

  // Layered Explanations
  oneLiner              String
  intuition             String?
  howItWorks            String?
  firstPrinciples       String?
  mathematicalModel     String?
  commonMisconceptions  String?
  whyItMatters          String?
  example               String?
  
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Relationships
  sources               SourceConcept[]
  outgoingConnections   Connection[]    @relation("SourceConcept")
  incomingConnections   Connection[]    @relation("TargetConcept")
  questions             Question[]
}

model Source {
  id             String          @id @default(cuid())
  title          String
  type           String          // "YOUTUBE" | "PODCAST" | "BOOK" | "PAPER" | "ARTICLE" | "LECTURE" | "NOTE" | "OTHER"
  url            String?
  author         String?
  publisher      String?
  publishedAt    String?
  accessedAt     DateTime?
  description    String?
  transcript     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  concepts       SourceConcept[]
  ingestionItems IngestionItem[]
}

model SourceConcept {
  id               String   @id @default(cuid())
  sourceId         String
  conceptId        String
  source           Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  concept          Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  
  // Contribution Metadata
  relevance        String?  // "primary" | "supporting" | "mention"
  contributionType String?  // "definition" | "mechanism" | "first_principles" | "evidence"
  excerpt          String?
  notes            String?
  evidenceStatus   String?  // "verified" | "hypothetical" | "historical"
  createdAt        DateTime @default(now())

  @@unique([sourceId, conceptId])
}

model Connection {
  id               String   @id @default(cuid())
  sourceConceptId  String
  targetConceptId  String
  relationshipType String   // "STRUCTURAL_ANALOGY" | "DIRECT_PHYSICAL_CONNECTION" | "CAUSAL_CONNECTION" | "MATHEMATICAL_CONNECTION" | "SHARED_PRINCIPLE" | "APPLICATION" | "CONTRAST"
  explanation      String
  strength         Float    @default(1.0)
  createdAt        DateTime @default(now())

  sourceConcept    Concept  @relation("SourceConcept", fields: [sourceConceptId], references: [id], onDelete: Cascade)
  targetConcept    Concept  @relation("TargetConcept", fields: [targetConceptId], references: [id], onDelete: Cascade)

  @@unique([sourceConceptId, targetConceptId])
}

model Question {
  id               String   @id @default(cuid())
  question         String
  description      String?
  chapterId        String?
  chapter          Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  relatedConceptId String?
  relatedConcept   Concept? @relation(fields: [relatedConceptId], references: [id], onDelete: SetNull)
  status           String   @default("OPEN") // "OPEN" | "EXPLORING" | "ANSWERED" | "ARCHIVED"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model IngestionItem {
  id                   String   @id @default(cuid())
  title                String
  sourceId             String?
  source               Source?  @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  rawContent           String?
  extractedSummary     String?
  candidateConcepts    String?  // JSON string or text summary of proposed concepts
  candidateConnections String?  // JSON string or text summary of proposed connections
  targetChapterId      String?
  status               String   @default("INBOX") // "INBOX" | "PROCESSING" | "REVIEW" | "ACCEPTED" | "REJECTED" | "ARCHIVED"
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
